# .gitlab-ci.yml 

stages:
  - build
  - push
  - deploy


variables:
  IMAGE_TAG: "$CI_REGISTRY_IMAGE:$CI_COMMIT_SHA"


build:
  stage: build

  script:
    - docker build -t "$IMAGE_TAG" .

  tags:
    - docker


push:
  stage: push

  script:
    - echo "$CI_REGISTRY_PASSWORD" | docker login "$CI_REGISTRY" --username "$CI_REGISTRY_USER" --password-stdin
    - docker push "$IMAGE_TAG"

  tags:
    - docker


deploy:
  stage: deploy

  script:
    - kubectl set image deployment/pathnex-deployment pathnex-app="$IMAGE_TAG"
    - kubectl rollout status deployment/pathnex-deployment

  tags:
    - kubernetes

  only:
    - main




