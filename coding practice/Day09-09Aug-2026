# 2. TERRAFORM
# ============================================================

# Purpose:
#   Create an EC2 Auto Scaling Group.

# terraform/main.tf
terraform {
    required_version = ">=1.6.0"

    required_providers {
        aws = {
            source = "hashicorp/aws"
            version = "~> 6.0"
        }
    }
}
provider "aws" {
    region = var.aws_region
}

# Variales

variable "aws_region" {
    description = "AWS region"
    type        = string
    default     = "ap-south-1"
}

variable " instance_type" {
    description = "EC2 instance type"
    type        = string
    default     = "t3.medium"
}

# DEFAULT VPC SUBNETS

data "aws_subnets" "default" {
    filter {
        name = "vpc-id"
        values = [data.aws_vpc.default.id]
    }
}

# latest Amazon Linux

data "aws_ami" "amazon_linux" {
    owners = ["122345678987"]

    filter {
        name = "name"
        values = ["a1314-ami-*-86_64"]
    }

    filter {
        name = "state"
        values = ["available"]
    }
}

# Security group 

resource "aws_security_group" "pathnex" {
    name        = "pathnex-day09-sg"
    description = "Security group for Pathnexx Day09"
    vpc_id      = data.aws_vpc.default.id

    ingress {
        description = "HTTP"
        from_port   = 80
        to_port     = 80
        protocol    = "tcp"
        cidr_blocks = ["0.0.0.0/0"]
    }
     ingress {
        description = "Nginx application"
        from_port   = 8080
        to_port     = 8080
        protocol    = "tcp"
        cidr_blocks = ["0.0.0.0/0"]
    }

    egress {
        from_port   = 0
        to_port     = 0
        protocol    = "-1"
        cidr_blocks = ["0.0.0.0/0"]
    }

    tags = {
        Name = "pathnex-day09-sg"
    }
}


# Launch Template 
resource "aws_launch_template" "pathnex" {
  name_prefix   = "pathnex-day09-"
  image_id      = data.aws_ami.amazon_linux.id
  instance_type = var.instance_type

  vpc_security_group_ids = [
    aws_security_group.pathnex.id
  ]

  block_device_mappings {
    device_name = "/dev/xvda"

    ebs {
      volume_size           = 20
      volume_type           = "gp3"
      delete_on_termination = true
    }
  }

  user_data = base64encode(<<-USERDATA
    #!/bin/bash

    dnf update -y

    dnf install -y docker

    systemctl enable docker
    systemctl start docker

    docker pull nginx:1.29-alpine

    docker run -d \
      --name nginx-container \
      --restart unless-stopped \
      -p 8080:80 \
      nginx:1.29-alpine
  USERDATA
  )

  tag_specifications {
    resource_type = "instance"

    tags = {
      Name = "pathnex-day09"
    }
  }
}

# AUTO SCALING GROUP 

resource " aws_autoscaling_group" "pathnex" {
    name = "pathnex-day09-asg"

  min_size         = 1
  desired_capacity = 2
  max_size         = 3

  vpc_zone_identifier = data.aws_subnets.default.ids

  launch_template {
    id      = aws_launch_template.pathnex.id
    version = "$Latest"
  }

  health_check_type         = "EC2"
  health_check_grace_period = 300

  tag {
    key                 = "Name"
    value               = "pathnex-day09-asg"
    propagate_at_launch = true
  }
}


# OUTPUT

output "autoscaling_group_name" {
  value = aws_autoscaling_group.pathnex.name
}

output "launch_template_id" {
  value = aws_launch_template.pathnex.id
}


# kubernates/deployment-hpa.yaml

apiVersion: apps/v1
kind: Deployment

metadata:
    name: pathnex-deployment

    selector:
        matchLabels:
            ap: pathnex-app

    template:
        metadata:
            labels:
                app: pathnex-app
        spec:
            containers:
                - name: pathnex-app

                  image: your_dockerhu_username/pathnex-app:latest

                  ports:
                    - containerPort :80

                  resources:
                    requests:
                        cpu: "100m"
                        memory: "64Mi"

                    limits:
                        cpu: "500m"
                        memory: "128Mi"
                  readlinessProbe:
                    httpGet:
                        path: /
                        port: 80
                    initialDelaySeconds: 5
                    periodSeconds: 10
                  livenessProbe:
                    httpGet:
                        path :/
                        port:80
                    initialDelaySeconds: 10
                    periodSeconds: 20
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler

metadata:
    name: pathnex-hpa
spec:
    scaleTargetRef:
        apiVersion: apps/v1
        kind: Deployment
        name: pathnex-deployment
    minReplicas: 2
    maxReplicas: 10

    metrics: 
        - type : Resource

         resource:
            name: cpu

            target:
                type: Utilixation
                averageUtilization: 50

# kubernetes/service.yaml

apiVerion: v1
kind: Service

metadata:
    name: pathnex-service
spec:
    type: NodePort

    selector:
        app: Pathnex-app

    ports: 
        - protocol: TCP
          port:80
          targetPort: 80
          nodePort: 30007


# 5. JENKINS PIPELINE
# ============================================================
#
# Pipeline:
#
#   Git > Build > Push image >   Kubernetes

pipeline {

    agent any 
    environment {
        IMAGE_NAME = "your_dockerhub_username/pathnex-app"
        IMAGE_TAG  = "${GIT_COMMIT}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t${ImAGE_NAME}:${IMAGE_TAG} \
                        .                
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | \
                        docker login \
                        --username "$DOCKER_USERNAME" \
                        --password-stdin
                        docker push ${IMAGE_NAME}: ${IMAGE_TAG}
                        docker logout
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    kubectl set image \
                        deployment/pathnex-deployment \
                        pathnex-app=${IMAGE_NAME}:${IMAGE_TAG}

                    kubectl rollout status \
                        deployment/pathnex-deployment

                '''
            }
        }

    }
}

