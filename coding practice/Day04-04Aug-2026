GITLAB CI/CD

# WHOLE PROCESS STAGES
stages:
    - build
    - test
    - docker
    - deployment


# PREDEFINED VARIALES
variables:
    IMAGE_NAME: registry.gitlab.com/amazon/ecommerce


# BUILD STAGE 
build: 
    stage: build
    script:
        - mvn clean package
    artifacts: 
        paths:
            - target/* .jar


# TEST STAGE 
test:
    stage: test
    script: 
        -mvn test 


# DOCKER CONTAINERIZING STAGE 
docker:
    stage: docker 
    script:
        - docker build -t $IMAGE_NAME:$CI_COMMIT_SHORT_SHA .
        - docker push $IMAGE_NAME:$CI_COMMMIT_SHORT_SHA

# DEPLOYMENT STAGE 
deploy:
    stage: deploy
    script: 
        - kubectl apply -f k8s/ 


