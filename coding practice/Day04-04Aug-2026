--- 
- name: Configure Web Server
  hosts: webservers
  become: yes

  tasks:
        
    - name: Install Apache
      yum:
        name: httpd
        state: present
    
    - name Copy Website
      copy:
        src:./website/
        dest: /var/www/html/ 

    - name: Start Apache
      service: 
        name: httpd
        state: started 
        enabled; yes
    
    - name: Open HTTP Pors
      firewalid:
        service: http
        permanent: yes
        state: enabled
        immediate: yes

