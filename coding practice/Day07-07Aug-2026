Step 2: Ansible (Configure Server)

├── ansible/
│   ├── inventory.ini
│   ├── nginx.yml
│   └── files/
│       └── nginx.conf

-----------------------------------------------------
[web]

54.21.xx.xx


-----------------------------------------------------
nginx.yml

- name: Configure nginx
  hosts: web
  become: yes
  tasks: 
    - name: Install nginx
      yum:
        name: nginx
        state: present
    
    - name: Copy configuration
      copy: 
        src: files/nginx.conf
        dest: /etx/nginx/nginx.conf
    
    - name: Enable Service 
      service: 
        name: nginx
        state: started
        enabled: yes 


