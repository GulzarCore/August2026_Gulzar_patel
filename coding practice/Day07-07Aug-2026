Step 4: Kubernetes
├── kubernetes/
│   ├── deployment.yaml
│   ├── service.yaml
│   ├── configmap.yaml
│   └── secret.yaml


-----------------------------------------------------
Deployment 

apiversion: app/v1
kind: Deployment
metadata:
    name: java-app 

spec:
    replicas: 3

    selector:
        matchLables: 
            app: java 
    template:
        metadata:
            labels:
                app: java
    spec:
        containers:
            - name java-containers
              image: pathnex-java:latest
              ports:
                - containerPort: 8080
              envFrom:
              - configMapRef:
                    name: app-config
              - secretref:
                    name: app-secret 

